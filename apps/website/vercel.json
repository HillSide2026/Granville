{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sign-in", "destination": "https://portal.granvillefinance.ca/sign-in", "permanent": false },
    { "source": "/sign-up", "destination": "https://portal.granvillefinance.ca/sign-up", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
