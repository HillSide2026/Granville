<style is:inline>
  :root {
    --aw-font-sans: var(--granville-font-sans);
    --aw-font-serif: Georgia;
    --aw-font-heading: var(--granville-font-heading);

    --aw-color-primary: var(--granville-color-slate-300);
    --aw-color-secondary: var(--granville-color-marketing-premium);
    --aw-color-accent: var(--granville-color-marketing-accent);

    --aw-color-text-heading: var(--granville-color-slate-50);
    --aw-color-text-default: var(--granville-color-slate-50);
    --aw-color-text-muted: color-mix(in srgb, var(--granville-color-slate-300) 72%, transparent);
    --aw-color-bg-page: var(--granville-color-navy-900);

    --aw-color-bg-page-dark: var(--granville-color-navy-950);

    ::selection {
      background-color: color-mix(in srgb, var(--granville-color-marketing-accent) 40%, transparent);
    }
  }

  .dark {
    --aw-font-sans: var(--granville-font-sans);
    --aw-font-serif: Georgia;
    --aw-font-heading: var(--granville-font-heading);

    --aw-color-primary: var(--granville-color-slate-300);
    --aw-color-secondary: var(--granville-color-marketing-premium);
    --aw-color-accent: var(--granville-color-marketing-accent);

    --aw-color-text-heading: var(--granville-color-slate-50);
    --aw-color-text-default: var(--granville-color-slate-50);
    --aw-color-text-muted: color-mix(in srgb, var(--granville-color-slate-300) 72%, transparent);
    --aw-color-bg-page: var(--granville-color-navy-900);

    ::selection {
      background-color: color-mix(in srgb, var(--granville-color-marketing-accent) 40%, transparent);
      color: var(--granville-color-slate-50);
    }
  }
</style>
