---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import { twMerge } from 'tailwind-merge';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  actions = await Astro.slots.render('actions'),
  panelBg = await Astro.slots.render('panelBg'),

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div
    class={twMerge(
      'max-w-3xl mx-auto text-center p-6 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600',
      classes?.panel as string
    )}
  >
    {
      panelBg && (
        <div class="pointer-events-none absolute inset-0 -z-[1]" aria-hidden="true">
          <Fragment set:html={panelBg} />
        </div>
      )
    }
    <div class={twMerge('flex flex-col', classes?.inner as string)}>
      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'mb-0 md:mb-0',
          title: 'text-4xl md:text-4xl font-bold tracking-tighter mb-4 font-heading',
          subtitle: 'text-xl text-muted dark:text-slate-400',
          ...((classes?.headline as object) ?? {}),
        }}
      />
      {
        actions && (
          <div
            class={twMerge(
              'max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 mt-6',
              classes?.actions as string
            )}
          >
            {Array.isArray(actions) ? (
              actions.map((action) => (
                <div class={twMerge('flex w-full sm:w-auto', classes?.actionWrap as string)}>
                  <Button {...(action || {})} class={twMerge('w-full sm:mb-0', action?.class as string)} />
                </div>
              ))
            ) : (
              <Fragment set:html={actions} />
            )}
          </div>
        )
      }
    </div>
  </div>
</WidgetWrapper>
