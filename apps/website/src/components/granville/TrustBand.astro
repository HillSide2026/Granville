---
/**
 * TrustBand — slim credibility strip beneath the hero.
 *
 * Uses capability statements (not certifications or client logos) so the
 * copy is honest pre-launch. Swap `items` for partner/regulator logos or
 * named certifications once they are confirmed.
 */
interface Props {
  label?: string;
  items?: readonly string[];
}

const {
  label = 'Financial Infrastructure for Successful, Global Founders',
  items = [],
} = Astro.props;
---

<section class="relative border-y" style="border-color: var(--granville-color-marketing-hairline); background: var(--granville-color-marketing-section-payments);">
  <div class="mx-auto max-w-7xl px-4 py-7 sm:px-6 md:py-8">
    <p class="text-center text-[0.7rem] font-semibold uppercase tracking-[0.22em]" style="color: rgba(148,163,184,0.72);">
      {label}
    </p>
    {items.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-3 sm:gap-x-5">
        {items.map((item, i) => (
          <Fragment>
            {i > 0 && <span class="hidden h-1 w-1 rounded-full sm:inline-block" style="background: var(--granville-color-accent-gold-line);" aria-hidden="true" />}
            <span class="text-[0.82rem] font-medium tracking-tight sm:text-[0.9rem]" style="color: var(--granville-color-slate-100);">{item}</span>
          </Fragment>
        ))}
      </div>
    )}
  </div>
</section>
