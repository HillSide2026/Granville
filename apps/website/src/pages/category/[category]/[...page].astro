---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { blogCategoryRobots, blogPostsPerPage, fetchPosts } from '~/utils/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await fetchPosts();

  const categoryMap = new Map<string, { slug: string; title: string }>();
  for (const post of posts) {
    if (post.category && !categoryMap.has(post.category.slug)) {
      categoryMap.set(post.category.slug, post.category);
    }
  }

  return Array.from(categoryMap.entries()).flatMap(([slug, category]) =>
    paginate(
      posts.filter((p) => p.category?.slug === slug),
      {
        params: { category: slug },
        props: { category },
        pageSize: blogPostsPerPage,
      },
    ),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, category } = Astro.props as Props;
const currentPage = page.currentPage;

const metadata = {
  title: `Category: ${category.title}${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: blogCategoryRobots,
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>
      {`Category: ${category.title}${currentPage > 1 ? ` — Page ${currentPage}` : ''}`}
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
