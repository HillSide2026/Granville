<style is:inline>
  :root {
    --aw-font-sans: system-ui;
    --aw-font-serif: Georgia;
    --aw-font-heading: system-ui;

    --aw-color-primary: rgb(184 198 214);
    --aw-color-secondary: rgb(213 191 155);
    --aw-color-accent: rgb(159 147 180);

    --aw-color-text-heading: rgb(243 237 227);
    --aw-color-text-default: rgb(243 237 227);
    --aw-color-text-muted: rgb(169 181 194 / 72%);
    --aw-color-bg-page: rgb(7 17 27);

    --aw-color-bg-page-dark: rgb(4 9 16);

    ::selection {
      background-color: rgb(159 147 180 / 40%);
    }
  }

  .dark {
    --aw-font-sans: system-ui;
    --aw-font-serif: Georgia;
    --aw-font-heading: system-ui;

    --aw-color-primary: rgb(184 198 214);
    --aw-color-secondary: rgb(213 191 155);
    --aw-color-accent: rgb(159 147 180);

    --aw-color-text-heading: rgb(243 237 227);
    --aw-color-text-default: rgb(243 237 227);
    --aw-color-text-muted: rgb(169 181 194 / 72%);
    --aw-color-bg-page: rgb(7 17 27);

    ::selection {
      background-color: rgb(159 147 180 / 40%);
      color: rgb(243 237 227);
    }
  }
</style>
