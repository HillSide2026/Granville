# ============================================================
# Granville environment variables — copy to .env and fill in.
# No secrets are committed to version control. All credentials
# are read from environment variables at runtime.
# ============================================================

# --- Granville API ---
PORT=8080

# --- Ops UI ---
OPS_UI_PORT=8081
GRANVILLE_API_URL=http://localhost:8080

# API token for ops-ui and internal service calls.
# Rotate before any non-development deployment.
GRANVILLE_API_TOKEN=dev-admin

# --- Postgres ---
# Used by the API server and db:migrate script.
DATABASE_URL=postgresql://granville:granville@localhost:5433/granville?sslmode=disable

# Set to 1 to run migrations automatically on API startup.
# Leave unset in production — run migrations as a separate step.
# GRANVILLE_AUTO_MIGRATE=1

# Reconciliation schedule. Default: 3600000 (1 hour). Set to 0 to disable.
# GRANVILLE_RECONCILE_INTERVAL_MS=3600000

# Aging pass schedule (escalates stale exceptions). Default: 900000 (15 min). Set to 0 to disable.
# GRANVILLE_AGING_INTERVAL_MS=900000

# --- Formance Ledger ---
# Leave unset to use the mock Formance client (in-memory, no real postings).
# Set to a running Formance instance to enable real ledger integration.
# FORMANCE_LEDGER_URL=http://localhost:3068
FORMANCE_LEDGER_NAME=granville

# --- Airwallex ---
# Sandbox credentials. Use https://api-demo.airwallex.com for sandbox.
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_WEBHOOK_SECRET=
# AIRWALLEX_BASE_URL=https://api-demo.airwallex.com

# TEST_DATABASE_URL is used by the test suite (npm run test:granville).
# It must point to a separate database from DATABASE_URL to avoid test data
# contaminating the development database.
# TEST_DATABASE_URL=postgresql://granville:granville@localhost:5433/granville?sslmode=disable

# --- Observability (optional) ---
# Set OTEL_TRACES_EXPORTER=otlp to enable trace export to a collector.
OTEL_SERVICE_NAME=granville-api
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
