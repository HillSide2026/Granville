# ============================================================
# Granville environment variables — copy to .env and fill in
# ============================================================

# --- Granville API ---
GRANVILLE_API_PORT=8080

# --- Ops UI ---
OPS_UI_PORT=8081
GRANVILLE_API_URL=http://localhost:8080
GRANVILLE_API_TOKEN=dev-admin

# --- Granville Postgres (operational DB — future) ---
GRANVILLE_POSTGRES_URI=postgresql://granville:granville@localhost:5432/granville?sslmode=disable
GRANVILLE_POSTGRES_MAX_OPEN_CONNS=20
GRANVILLE_POSTGRES_MAX_IDLE_CONNS=10
GRANVILLE_POSTGRES_CONN_MAX_IDLE_TIME=5m

# --- Formance Ledger ---
FORMANCE_LEDGER_URL=http://localhost:3068
FORMANCE_LEDGER_NAME=granville

# --- Provider adapters ---
# Uncomment and fill in when connecting real providers.
# NATIVE_EMI_API_URL=https://api.youremi.com
# NATIVE_EMI_API_KEY=
# NATIVE_EMI_WEBHOOK_SECRET=

# Airwallex native EMI adapter.
# Defaults to dry-run until provider-native payment payload mapping is implemented.
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_WEBHOOK_SECRET=
# AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
# AIRWALLEX_LOGIN_AS=
# AIRWALLEX_DRY_RUN=true

# --- Observability ---
OTEL_SERVICE_NAME=granville-api
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# --- Local development overrides ---
# These are set automatically by docker-compose.local.yml.
# Only set them here when running services outside of compose.
# POSTGRES_URI=postgresql://ledger:ledger@localhost:5432/ledger?sslmode=disable
